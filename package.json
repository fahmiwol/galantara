{
  "name": "galantara-repo",
  "version": "0.10.0",
  "private": true,
  "description": "Galantara — static web (Three.js + ES modules) + Socket.io multiplayer server",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node galantara-server/index.js --local",
    "test": "node --experimental-default-type=module --test tests/*.test.mjs && npm run periksa:tautan",
    "test:unit": "node --experimental-default-type=module --test tests/*.test.mjs",
    "periksa:tautan": "node tools/periksa-tautan.mjs",
    "install:server": "cd galantara-server && npm install",
    "server": "cd galantara-server && npm start",
    "server:dev": "cd galantara-server && npm run dev",
    "audit:visual": "node tools/benteng-visual-audit.mjs",
    "sim:benteng": "node tools/benteng-sim.mjs --runs 100"
  }
}
